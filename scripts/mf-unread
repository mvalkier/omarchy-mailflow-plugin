#!/usr/bin/env python3
"""Unread mail counter for the MailFlow bar widget.

Polls MailFlow's own API (GET /api/mail/unread-counts) with a MailFlow session
and prints one JSON line per reading on stdout, so BarWidget.qml can follow
along line by line:

    {"ok": true, "url": "...", "total": 3, "complete": true, "accounts": [...], "time": 1791...}
    {"ok": false, "url": "..." | null, "reason": "login" | "unreachable"}

    mf-unread           keep running, one reading every INTERVAL seconds
    mf-unread --once    a single reading, for testing
    mf-unread login     sign in interactively (password, then TOTP or email code)
    mf-unread logout    end the session and forget it

MailFlow has no API tokens, only browser sessions. `login` signs in like the web
app does and keeps the session cookie (never the password) in
~/.config/mailflow-bar/session.json (mode 600), outside the plugin directory so
a reinstall does not lose it. Every poll extends the session; it expires after
7 days without use or when the account password changes.
"""
import getpass
import http.cookiejar
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

SESSION_FILE = (
    Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    / "mailflow-bar"
    / "session.json"
)
# MailFlow refreshes its counts about once a minute; asking more often gains nothing.
INTERVAL = 30
# After a failed connection (e.g. right after wake, before Wi-Fi or VPN is up).
RETRY = 5
# How often the wait loop checks the clock and the session file.
STEP = 2
TIMEOUT = 10
USER_AGENT = "omarchy-mailflow-plugin"

# accountId -> email address; filled from /api/accounts when an unknown id shows up.
addresses = {}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse redirects: urllib copies every request header, including the
    session Cookie, to the redirect target, whatever its host or scheme. The
    MailFlow API never redirects, so a 3xx here is treated as an HTTP error."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def build_opener(*handlers):
    return urllib.request.build_opener(NoRedirect, *handlers)


opener = build_opener()


def emit(reading):
    print(json.dumps(reading), flush=True)


# ── Session file ───────────────────────────────────────────────────────────


def load_session():
    try:
        data = json.loads(SESSION_FILE.read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    return data


def save_session(url, cookie):
    folder = SESSION_FILE.parent
    folder.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = folder / f".session.{os.getpid()}.tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump({"url": url, "cookie": cookie}, f)
            f.write("\n")
        os.replace(tmp, SESSION_FILE)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def session_mtime():
    try:
        return SESSION_FILE.stat().st_mtime_ns
    except OSError:
        return None


# ── Polling ────────────────────────────────────────────────────────────────


def get_json(url, cookie):
    request = urllib.request.Request(
        url,
        headers={"Cookie": cookie, "Accept": "application/json", "User-Agent": USER_AGENT},
    )
    with opener.open(request, timeout=TIMEOUT) as response:
        return json.load(response)


def measure():
    session = load_session() or {}
    url = session.get("url") or None
    cookie = session.get("cookie") or None
    if not url or not cookie:
        return {"ok": False, "url": url, "reason": "login"}
    try:
        data = get_json(f"{url}/api/mail/unread-counts", cookie)
        by_account = data.get("byAccount") or {}
        snapshots = data.get("snapshots") or {}
        if any(account_id not in addresses for account_id in by_account):
            accounts = get_json(f"{url}/api/accounts", cookie)
            addresses.update({a["id"]: a["email_address"] for a in accounts})
        result = {
            "ok": True,
            "url": url,
            "total": int(data["total"]),
            # MailFlow before 3.4 has no `complete`: shown as out of date.
            "complete": data.get("complete") is True,
            "accounts": sorted(
                (
                    {
                        "email": addresses.get(account_id, account_id),
                        "unread": None if count is None else int(count),
                        "stale": (snapshots.get(account_id) or {}).get("stale", True) is True,
                    }
                    for account_id, count in by_account.items()
                ),
                key=lambda a: a["email"],
            ),
            "time": int(time.time()),
        }
    except urllib.error.HTTPError as error:
        # 401: session gone or expired; 423: session locked.
        reason = "login" if error.code in (401, 423) else "unreachable"
        return {"ok": False, "url": url, "reason": reason}
    except (urllib.error.URLError, TimeoutError, OSError, ValueError, KeyError, TypeError):
        return {"ok": False, "url": url, "reason": "unreachable"}
    return result


def boottime():
    # CLOCK_BOOTTIME keeps running during suspend, unlike time.monotonic(): after
    # wake the next reading comes within STEP seconds, not after a full INTERVAL.
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def poll():
    while True:
        reading = measure()
        emit(reading)
        mtime = session_mtime()
        wait = RETRY if reading.get("reason") == "unreachable" else INTERVAL
        deadline = boottime() + wait
        # A new login or logout changes the session file: measure right away.
        while boottime() < deadline and session_mtime() == mtime:
            time.sleep(STEP)


# ── login / logout ─────────────────────────────────────────────────────────


def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def normalize_url(raw):
    url = raw.strip().rstrip("/")
    if "://" not in url:
        url = "https://" + url
    parts = urllib.parse.urlsplit(url)
    if parts.scheme not in ("http", "https") or not parts.netloc:
        fail(f"Not a valid http(s) URL: {raw.strip()}")
    return url


def login():
    if not sys.stdin.isatty():
        fail("mf-unread login needs a terminal.", 2)

    previous = (load_session() or {}).get("url") or ""
    prompt = f"MailFlow URL [{previous}]: " if previous else "MailFlow URL: "
    raw = input(prompt).strip() or previous
    if not raw:
        fail("No URL given.")
    url = normalize_url(raw)
    username = input("Username: ").strip()
    password = getpass.getpass("Password: ")

    jar = http.cookiejar.CookieJar()
    login_opener = build_opener(urllib.request.HTTPCookieProcessor(jar))

    def post(path, body):
        request = urllib.request.Request(
            f"{url}{path}",
            data=json.dumps(body).encode(),
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Accept": "application/json",
                "X-Requested-With": "XMLHttpRequest",
                "User-Agent": USER_AGENT,
            },
        )
        try:
            with login_opener.open(request, timeout=TIMEOUT) as response:
                return response.status, json.load(response)
        except urllib.error.HTTPError as error:
            try:
                payload = json.load(error)
            except ValueError:
                payload = {}
            if not isinstance(payload, dict):
                payload = {}
            fail(f"Sign-in failed: {payload.get('error') or f'HTTP {error.code}'}")
        except (urllib.error.URLError, TimeoutError, OSError) as error:
            fail(f"Cannot reach {url}: {getattr(error, 'reason', error)}")
        except ValueError:
            fail(f"Sign-in failed: {url} did not answer with JSON. Is this a MailFlow URL?")

    _, answer = post("/api/auth/login", {"username": username, "password": password})
    if answer.get("requiresMFAEnrollment"):
        fail(
            "MailFlow requires two-factor setup for this account. "
            "Set it up in the web app, then sign in again."
        )
    if answer.get("requiresTOTP"):
        code = input("Authenticator code: ").strip()
        _, answer = post("/api/auth/2fa/challenge", {"code": code})
    elif answer.get("requiresEmailOTP"):
        print(f"A sign-in code was sent to {answer.get('emailHint') or 'your email address'}.")
        code = input("Email code: ").strip()
        _, answer = post("/api/auth/2fa/verify-email-otp", {"code": code})
    if not answer.get("user"):
        fail(f"Sign-in failed: unexpected answer from {url}.")

    cookie = "; ".join(f"{c.name}={c.value}" for c in jar)
    if not cookie:
        fail("MailFlow did not return a session cookie.")

    try:
        data = get_json(f"{url}/api/mail/unread-counts", cookie)
        status = 200
    except urllib.error.HTTPError as error:
        data, status = {}, error.code
    except (urllib.error.URLError, TimeoutError, OSError, ValueError):
        data, status = {}, "?"
    if status != 200 or not isinstance(data, dict) or "complete" not in data:
        fail(
            f"Signed in, but /api/mail/unread-counts failed (HTTP {status}). "
            "MailFlow 3.4 or newer is required."
        )

    save_session(url, cookie)
    print(f"Signed in to {url}. The bar updates within a few seconds.")


def logout():
    session = load_session()
    if session is None:
        print("Not signed in.")
        return
    url, cookie = session.get("url"), session.get("cookie")
    if url and cookie:
        request = urllib.request.Request(
            f"{url}/api/auth/logout",
            data=b"",
            method="POST",
            headers={
                "Cookie": cookie,
                "X-Requested-With": "XMLHttpRequest",
                "User-Agent": USER_AGENT,
            },
        )
        try:
            with opener.open(request, timeout=TIMEOUT):
                pass
        except urllib.error.HTTPError:
            pass
        except (urllib.error.URLError, TimeoutError, OSError):
            print(
                "Could not reach MailFlow; the server session expires after 7 days without use.",
                file=sys.stderr,
            )
    SESSION_FILE.unlink(missing_ok=True)
    print("Signed out.")


def main():
    args = sys.argv[1:]
    if not args:
        poll()
    elif args == ["--once"]:
        emit(measure())
    elif args == ["login"]:
        login()
    elif args == ["logout"]:
        logout()
    else:
        fail("usage: mf-unread [--once | login | logout]", 2)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
    except (KeyboardInterrupt, EOFError):
        print(file=sys.stderr)
        sys.exit(130)
